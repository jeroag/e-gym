# ── Conexión a Postgres ───────────────────────────────────
# Cualquier Postgres vale: Supabase, Neon, Railway, local, etc.
# Supabase: Dashboard → Project Settings → Database → Connection string (URI)
# Local:    postgresql://user:pass@localhost:5432/egym
DATABASE_URL=postgresql://user:password@host:5432/egym

# ── Secret para firmar JWTs ───────────────────────────────
# Genera uno largo y aleatorio. Ej: openssl rand -hex 64
JWT_SECRET=cambia_este_secret_a_uno_largo_y_aleatorio

# ── Servidor ──────────────────────────────────────────────
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Licencia de entrenador ────────────────────────────────
# Código que debe introducir un entrenador al registrarse.
# Déjalo vacío para deshabilitar el registro de entrenadores.
TRAINER_LICENSE_CODE=cambia_este_codigo
